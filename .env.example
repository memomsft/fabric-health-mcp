# fabric-health-mcp — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env a Git

# Opcional: forzar un tenant específico si tienes acceso a múltiples
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Opcional: para ambientes donde az login no está disponible
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET=tu-secret-aqui

# Directorio donde se guardan los reportes generados (default: ./reports)
# FABRIC_HEALTH_REPORTS_DIR=C:\Users\tu_usuario\Documents\fabric-reports
